# `python start.py --setup` fills these in for you (in backend/.env).
# To do it by hand, copy this file to backend/.env. .env files are gitignored.
# Abyss makes real AI calls, so at least one key is needed.
OPENAI_API_KEY=
MODEL_API_KEY=
# Default AI for new sessions when both keys are set: openai or meta.
ABYSS_PROVIDER=openai
